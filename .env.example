# The daemon's public HTTP surface: generated REST routes and the projection
# stream are both served from it. The stream URL is derived from this by
# swapping the scheme, so there is one address to configure rather than two.
VITE_SIGNAL_GARDEN_HTTP=http://localhost:8080

# How often the performance panel polls GET /v1/runs/{run_id}/telemetry.
# Telemetry does not stream until M3; see the daemon's docs/contracts.md.
VITE_TELEMETRY_POLL_MS=1000

# The daemon image compose runs, from the local Docker image store. `local` is
# the moving tag `task docker:build` writes in the daemon checkout for a build
# matching this machine's architecture. Nothing is pulled from a registry.
SIGNAL_GARDEN_IMAGE=signal-garden/signalgardend
SIGNAL_GARDEN_IMAGE_TAG=local
